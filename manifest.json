{
    "manifest_version": 3,
    "name": "playphrase.me",
    "version": "3.0",
    "description": "playphrase.me next",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "playphrase.me next"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.playphrase.me/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "style.css"
            ]
        }
    ]
}